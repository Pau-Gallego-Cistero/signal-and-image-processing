Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Abrir", " ", "el", " ", "archivo"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rutaArchivo", "=", 
     RowBox[{"SystemDialogInput", "[", "\"\<FileOpen\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Comprobamos", " ", "si", " ", "se", " ", "seleccion\[OAcute]", " ", "un",
      " ", "archivo", " ", "v\[AAcute]lido"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"rutaArchivo", "===", "$Canceled"}], "||", 
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "rutaArchivo", "]"}]}]}], ",", 
     RowBox[{
     "Print", "[", 
      "\"\<No se ha seleccionado ning\[UAcute]n archivo. El c\[OAcute]digo se \
detiene.\>\"", "]"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "SI"}]}], " ", "EL", " ", "ARCHIVO", " ", "EXISTE"}], 
       ",", 
       RowBox[{
        RowBox[{"EJECUTAMOS", " ", "TODO", " ", "EL", " ", 
         RowBox[{"AN\[CapitalAAcute]LISIS", "--"}]}], "-"}]}], "*)"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Cargando archivo: \>\"", ",", 
         RowBox[{"FileBaseName", "[", "rutaArchivo", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Importamos", " ", "como", " ", "objeto", " ", "Audio"}], 
        "*)"}], 
       RowBox[{"LetDown", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"rutaArchivo", ",", "\"\<Audio\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"LetDown", "===", "$Failed"}], ",", 
         RowBox[{
         "Print", "[", 
          "\"\<Error cr\[IAcute]tico: No se pudo importar el audio. Revisa el \
archivo.\>\"", "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Si", " ", "importa", " ", "bien"}], ",", 
           RowBox[{"seguimos", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{"(*", "Discretizaci\[OAcute]n", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Muestreo", "=", 
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"AudioSampleRate", "[", "LetDown", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Datos", "=", 
            RowBox[{"AudioData", "[", "LetDown", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Conversi\[OAcute]n", " ", "a", " ", "Mono"}], "*)"}], 
           RowBox[{"DatoAura", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MatrixQ", "[", "Datos", "]"}], ",", 
              RowBox[{"Mean", "[", "Datos", "]"}], ",", "Datos"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{
           "Print", "[", "\"\<Audio cargado correctamente.\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Duraci\[OAcute]n: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Length", "[", "DatoAura", "]"}], "/", "Muestreo"}], 
              "]"}], ",", "\"\< s | Frecuencia: \>\"", ",", "Muestreo", ",", 
             "\"\< Hz\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "FOURIER", "*)"}], 
           RowBox[{
           "Print", "[", "\"\<Calculando Transformada de Fourier...\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"transformadaCompleta", "=", 
            RowBox[{"Fourier", "[", 
             RowBox[{"DatoAura", ",", 
              RowBox[{"FourierParameters", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"mitadPuntos", "=", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"Length", "[", "transformadaCompleta", "]"}], "/", 
              "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"espectroCompleto", "=", 
            RowBox[{"Abs", "[", 
             RowBox[{"transformadaCompleta", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "mitadPuntos"}], "]"}], "]"}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
           "Print", "[", "\"\<Generando gr\[AAcute]ficos...\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"graficoTiempo", "=", 
            RowBox[{"ListLinePlot", "[", 
             RowBox[{
              RowBox[{"DatoAura", "[", 
               RowBox[{"[", 
                RowBox[{"1", ";;", 
                 RowBox[{"Min", "[", 
                  RowBox[{"50000", ",", 
                   RowBox[{"Length", "[", "DatoAura", "]"}]}], "]"}]}], "]"}],
                "]"}], ",", 
              RowBox[{
              "PlotLabel", "\[Rule]", 
               "\"\<1. Se\[NTilde]al en el Tiempo (Zoom inicial)\>\""}], ",", 
              RowBox[{"AxesLabel", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"\"\<Muestras\>\"", ",", "\"\<Amplitud\>\""}], 
                "}"}]}], ",", 
              RowBox[{"ImageSize", "\[Rule]", "Medium"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"graficoFrecuencia", "=", 
            RowBox[{"ListLinePlot", "[", 
             RowBox[{"espectroCompleto", ",", 
              RowBox[{"DataRange", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"Muestreo", "/", "2"}]}], "}"}]}], ",", 
              RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
              RowBox[{
              "PlotLabel", "\[Rule]", 
               "\"\<2. Espectro de Frecuencias (Fourier)\>\""}], ",", 
              RowBox[{"AxesLabel", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"\"\<Frecuencia (Hz)\>\"", ",", "\"\<Magnitud\>\""}], 
                "}"}]}], ",", 
              RowBox[{"ImageSize", "\[Rule]", "Medium"}], ",", 
              RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Speed\>\""}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"ImageSize", "\[Rule]", 
             RowBox[{
             "Medium", " ", "para", " ", "que", " ", "tenga", " ", "el", " ", 
              "mismo", " ", "tama\[NTilde]o", " ", "que", " ", "los", " ", 
              "otros"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"graficoEspectrograma", "=", 
            RowBox[{"Spectrogram", "[", 
             RowBox[{"LetDown", ",", 
              RowBox[{"PlotLabel", "\[Rule]", "\"\<3. Espectrograma\>\""}], 
              ",", 
              RowBox[{"ImageSize", "\[Rule]", "Medium"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", "\"\<Visualizando resultados:\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
            "graficoTiempo", ",", "graficoFrecuencia", ",", 
             "graficoEspectrograma"}], "}"}]}], ")"}]}], "]"}]}], ")"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9727998413789215`*^9, 3.9728000352426043`*^9}, {
